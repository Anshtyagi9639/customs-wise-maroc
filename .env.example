# Production domain (no trailing slash) — used for canonical URLs, sitemap, Open Graph, JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.example.ma

# Moroccan office contact details — leave empty until confirmed (empty = not displayed)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only: endpoint receiving enquiry form submissions as JSON POST
# (Make / Zapier / Power Automate webhook, Formspree endpoint, etc.)
# Without it, the form tells visitors that online sending is not yet active.
CONTACT_WEBHOOK_URL=
