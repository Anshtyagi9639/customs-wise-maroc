# ─────────────────────────────────────────────────────────────────────────────
# Customs Wise Maroc — environment variables (placeholders only, never commit real values)
# Copy to .env.local for local development; set in Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* values are embedded at build time: redeploy after changing them.
# ─────────────────────────────────────────────────────────────────────────────

# Production domain, no trailing slash (canonical URLs, sitemap, Open Graph, JSON-LD).
# Optional on Vercel: falls back to VERCEL_PROJECT_PRODUCTION_URL (set automatically).
NEXT_PUBLIC_SITE_URL=

# Launch status. Anything other than "live" shows the "en cours de lancement" notice.
NEXT_PUBLIC_SITE_STATUS=

# Moroccan office contact details — leave empty until approved (empty = not displayed)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# Opening hours shown in the enquiry section, e.g. "Lundi – vendredi : 9h00 – 18h00"
NEXT_PUBLIC_OPENING_HOURS=
# WhatsApp number, digits only with country code (e.g. 212600000000).
# Shows the floating WhatsApp button — set ONLY once approved for public display.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Enquiry delivery (SERVER-ONLY secrets) ──────────────────────────────────
# At least one channel must be configured, otherwise the form tells visitors
# that online sending is not yet active. An enquiry counts as sent only if a
# configured channel accepts it.
#
# 1) Webhook: JSON POST (Make / Zapier / Power Automate / Formspree…).
#    CONTACT_WEBHOOK_URL is the existing name; ENQUIRY_WEBHOOK_URL is accepted too.
CONTACT_WEBHOOK_URL=
ENQUIRY_WEBHOOK_URL=
# Optional shared secret, sent as the X-Enquiry-Secret header
ENQUIRY_WEBHOOK_SECRET=
#
# 2) Email via the Resend HTTP API (visitor's address is set as Reply-To)
EMAIL_API_KEY=
EMAIL_FROM=
# Comma-separated recipient list
ENQUIRY_TO_EMAIL=
# Optional, defaults to https://api.resend.com/emails
EMAIL_API_URL=

# Analytics — leave both empty to disable tracking entirely (no consent banner shown).
# If GTM is set, GA4 must be configured inside GTM (NEXT_PUBLIC_GA_ID is then ignored).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# Search engine ownership verification (meta tag content values)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
